# Backend API Configuration
# Set your backend domain (without trailing slash)
# This will be used as: ${VITE_BACKEND_DOMAIN}/api
# In development, if not set, defaults to: https://localhost:3001
VITE_BACKEND_DOMAIN=https://your-backend-domain.com

# Optional: FreePik API Key (for additional style searches)
# Get your API key from: https://www.freepik.com/api
# VITE_FREEPIK_API_KEY=your_freepik_api_key_here

# Example for local development:
# VITE_BACKEND_DOMAIN=http://localhost:3001

# Example for production:
# VITE_BACKEND_DOMAIN=https://api.yourdomain.com
